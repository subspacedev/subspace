<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHITECTURE.md §12: strings live here from the first commit; no
     hardcoded UI text. ARCHITECTURE.md §5.6: no string here may interpolate a server
     address, uuid, or key. -->
<resources>
    <!-- Generic QR camera surface. The scanner emits decoded text only; the
         caller owns the meaning of that payload. -->
    <string name="qr_scan_cancel_description">Cancel scanning</string>
    <string name="qr_scan_cancel_button">Cancel</string>
    <string name="qr_scan_preview_description">Camera preview. Point the camera at a QR code to scan it.</string>
    <string name="qr_scan_permission_denied_message">Camera access is needed to scan a QR code.</string>
    <string name="qr_scan_grant_permission_button">Grant camera access</string>
    <string name="qr_scan_permission_permanently_denied_message">
        Camera access was denied. To scan a QR code, allow Camera for Subspace in system settings.
    </string>
    <string name="qr_scan_open_settings_button">Open settings</string>

    <!-- ConnectControl's accessible label names the action a tap performs,
         not the current connection state (a screen reader user needs to know
         what tapping does, not what already happened) — see the KDoc on
         ConnectControl.kt's actionDescription(). -->
    <string name="connect_control_action_connect">Connect</string>
    <string name="connect_control_action_connecting">Connecting</string>
    <string name="connect_control_action_disconnect">Disconnect</string>

    <!-- FloatingNavigationBar's own instrumented test uses these three as its
         representative destinations. Real screens build their own NavItem
         lists from their own feature module's strings (:core:ui cannot
         depend on :feature:*), but these names match the app's actual three
         top-level destinations, so a real caller may reuse them too. -->
    <string name="nav_item_connect">Connect</string>
    <string name="nav_item_servers">Servers</string>
    <string name="nav_item_settings">Settings</string>

    <!-- SubspaceBottomSheetTest's fixture title — no real caller exists yet
         (Task 19), so this is test-only, unlike the nav_item_* strings above. -->
    <string name="bottom_sheet_test_title">Sheet Title</string>

    <!-- GroupCard (Task 18). A group's name is not a secret the way a server
         address is (ARCHITECTURE.md §5.6) — it never interpolates one. -->
    <!-- %1$s = the group's title, %2$s = its subtitle (e.g. "3 servers"). -->
    <string name="group_card_expand_description">Expand %1$s, %2$s</string>
    <string name="group_card_collapse_description">Collapse %1$s, %2$s</string>
    <string name="group_card_overflow_description">More options for %1$s</string>
    <string name="group_card_rename">Rename</string>
    <string name="group_card_delete">Delete</string>
    <string name="group_card_add_profile">Add profile</string>
    <plurals name="group_card_profile_count">
        <item quantity="one">%1$d server</item>
        <item quantity="other">%1$d servers</item>
    </plurals>

    <!-- Task 14 fix round, Important 1/2: GroupCard's last-fetch age and
         Update button, SUBSCRIPTION groups only. %1$s in
         group_card_last_updated is android.text.format.DateUtils's own
         relative-time string (e.g. "3 hours ago"), already localized by the
         platform. %1$s in group_card_update_description is the group's name,
         same pattern as group_card_overflow_description above. -->
    <string name="group_card_last_updated">Updated %1$s</string>
    <string name="group_card_update_description">Update %1$s</string>

    <!-- Task 15: the overflow menu item that opens the subscription detail screen —
         SUBSCRIPTION groups only, same gating as onUpdate/group_card_update_description above. -->
    <string name="group_card_open_detail">Subscription details</string>

    <!-- ThroughputCard (M8.6 Task 9). %1$s = the busiest bucket as a rate, formatted by the caller. -->
    <string name="throughput_axis">-60m · %1$s peak · now</string>

    <!-- ServerRow (M8.6 Task 9). %1$s = the server's name. -->
    <string name="server_edit">Edit %1$s</string>
    <!-- The latency pill: %1$s = its text ("42 ms", "—"). The second form is used while
         the pill is disabled (nothing to re-test). -->
    <string name="server_latency_retest">Latency %1$s, tap to re-test</string>
    <string name="server_latency">Latency %1$s</string>

    <!-- QuotaBar (Task 14). %1$s/%2$s are already-formatted byte strings
         (e.g. "1.2 GB"), not raw numbers — see QuotaBar.kt's own
         toHumanReadableBytes(). -->
    <string name="quota_bar_label">%1$s of %2$s used</string>

    <!-- QuotaBar (Task 14 fix round, Important 3). Binary (1024-based) byte
         units, indexed 0..5 by toHumanReadableBytes()'s magnitude — was a
         hardcoded Kotlin list, moved here so M9 localisation has somewhere
         to translate them from. -->
    <string-array name="quota_bar_units">
        <item>B</item>
        <item>KB</item>
        <item>MB</item>
        <item>GB</item>
        <item>TB</item>
        <item>PB</item>
    </string-array>

    <!-- OutcomeTag (M8.6 Part 1, Task 7): what happens to an app's traffic. -->
    <string name="outcome_tunnelled">Tunnelled</string>
    <string name="outcome_direct">Direct</string>
    <string name="outcome_proxy">Proxy</string>
    <string name="outcome_block">Block</string>

    <!-- SearchField (M8.6 Part 1, Task 8). -->
    <string name="search_clear">Clear search</string>

    <!-- Obfuscation field problems (M9-A spec §2.3), shared by the settings page and subscription detail. -->
    <string name="obfuscation_problem_blank">Required</string>
    <string name="obfuscation_problem_not_a_range">Use a number or a range like 10-20</string>
    <string name="obfuscation_problem_reversed">The first number must not be larger than the second</string>
    <string name="obfuscation_problem_too_large">Number too large</string>
    <string name="obfuscation_problem_out_of_bounds">Outside the allowed range (length up to 16384, delay up to 1000 ms, counts up to 255)</string>
    <string name="obfuscation_problem_packets_from_zero">Packets start at 1</string>
    <string name="obfuscation_problem_length_from_zero">The minimum length must be at least 1</string>
    <string name="obfuscation_problem_rand_from_zero">The minimum must be at least 1 byte</string>
    <string name="obfuscation_problem_rand_range_over_255">Byte values go from 0 to 255</string>
    <string name="obfuscation_problem_packet_undecodable">This packet does not match its type</string>
    <string name="obfuscation_problem_packet_and_rand">A fixed packet and random bytes cannot be combined</string>
    <string name="obfuscation_problem_multiple_packets">Only one packets value is allowed</string>
    <!-- M9-E spec §3, §4, §7.1: why a tuning value is not applied (TuningProblemText.kt). -->
    <string name="tuning_reason_out_of_range">it must be between %1$d and %2$d</string>
    <string name="tuning_reason_bad_value">it isn\'t a valid value</string>
    <string name="tuning_reason_range_too_wide">a range in it covers every address</string>
    <string name="tuning_reason_range_covers_dns">a range in it covers the DNS server in use</string>
    <string name="tuning_reason_needs_consent">it\'s waiting for your answer on the provider\'s request card</string>
    <string name="tuning_reason_declined">you chose not to allow it</string>
    <string name="tuning_directive_ignored">%1$s is ignored: %2$s.</string>
    <string name="tuning_directive_partly_ignored">%1$s is partly ignored: %2$s.</string>
    <string name="tuning_directive_not_applied">%1$s isn\'t applied: %2$s.</string>
    <string name="tuning_subscription_value_ignored">your subscription\'s value is ignored: %1$s</string>
    <string name="tuning_subscription_value_partly_ignored">part of your subscription\'s value is ignored: %1$s</string>
    <string name="tuning_subscription_value_not_applied">your subscription\'s value isn\'t applied: %1$s</string>
</resources>
