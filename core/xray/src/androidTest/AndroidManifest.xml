<!-- The library itself declares no permissions (the app gets INTERNET from :service). The
     instrumented tests that open a loopback socket (CertificateProbeXrayTest) need it in the
     test APK, or socket() fails with EPERM. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
