{
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "dns": {
    "servers": ["1.1.1.1"]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "address": "hy.example.com",
        "port": 443
      },
      "streamSettings": {
        "network": "hysteria",
        "hysteriaSettings": {
          "version": 2,
          "auth": "hy2-password"
        },
        "finalmask": {"udp":[{"type":"noise","settings":{"noise":[{"rand":"10-20","randRange":"0-255","delay":"10-16"}]}}]},
        "security": "tls",
        "tlsSettings": {
          "serverName": "sni.example",
          "alpn": ["h3"]
        }
      }
    },
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": []
  }
}
