<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M10-C: LaunchAutomation's NetworkKindReader reads the underlying network's transport
      (Wi-Fi / mobile markers) and isActiveNetworkMetered (the launch test's metered gate).
      Declared in the module that makes the call, as :feature:profiles does for the same reason.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
